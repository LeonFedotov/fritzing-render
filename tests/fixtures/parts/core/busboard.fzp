<?xml version='1.0' encoding='UTF-8'?>
<module moduleId='BusBoardModuleID'>
 <title>Bus Board</title>
 <properties><property name='family'>test family</property></properties>
 <views>
  <schematicView><layers image='schematic/busboard.svg'><layer layerId='schematic'/></layers></schematicView>
 </views>
 <connectors>
  <connector id='connector0' name='GND' type='male'><description>ground, left</description>
   <views><schematicView><p layer='schematic' svgId='connector0pin' terminalId='connector0terminal'/></schematicView></views></connector>
  <connector id='connector1' name='GND' type='male'><description>ground, right</description>
   <views><schematicView><p layer='schematic' svgId='connector1pin' terminalId='connector1terminal'/></schematicView></views></connector>
  <connector id='connector2' name='SIG' type='male'><description>signal, top</description>
   <views><schematicView><p layer='schematic' svgId='connector2pin' terminalId='connector2terminal'/></schematicView></views></connector>
  <connector id='connector3' name='OUT' type='male'><description>output, bottom</description>
   <views><schematicView><p layer='schematic' svgId='connector3pin' terminalId='connector3terminal'/></schematicView></views></connector>
 </connectors>
 <buses><bus id='gnd'><nodeMember connectorId='connector0'/><nodeMember connectorId='connector1'/></bus></buses>
</module>
