<?xml version='1.0' encoding='UTF-8'?>
<module moduleId='FlatModuleID'>
 <title>Flat Part</title>
 <tags><tag>fixture</tag></tags>
 <properties><property name='family'>test family</property></properties>
 <views>
  <breadboardView>
   <layers image='breadboard/flat.svg'><layer layerId='breadboard'/></layers>
  </breadboardView>
 </views>
 <connectors>
  <connector id='connector0' name='IN' type='male'>
   <description>input pin</description>
   <views><breadboardView><p layer='breadboard' svgId='connector0pin'/></breadboardView></views>
  </connector>
  <connector id='connector1' name='OUT' type='male'>
   <description>output pin</description>
   <views><breadboardView><p layer='breadboard' svgId='connector1pin' terminalId='connector1terminal'/></breadboardView></views>
  </connector>
 </connectors>
</module>
